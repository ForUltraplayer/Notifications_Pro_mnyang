                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc SettingsWindow_ThemeHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc SettingsWindow_ChoosePresetThemeSettingsWindow}"/>
