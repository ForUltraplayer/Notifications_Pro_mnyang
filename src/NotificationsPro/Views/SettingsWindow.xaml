                        <TextBlock Text="{loc:Loc SettingsWindow_UIThemePreset}" Style="{StaticResource SettingLabel}"
                                   ToolTip="{loc:Loc SettingsWindow_UseSameNamedThemesOverlay}"/>
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
