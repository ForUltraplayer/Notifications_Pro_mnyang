                                                          ToolTip="{loc:Loc Filtering_EnableGiveRuleOwnHighlight2}"/>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValue}">
                                                        <Run Text="{Binding BorderThickness, StringFormat='{}{0:0.0}px'}"/>
                                                    </TextBlock>
                                                    <Slider Minimum="0.5" Maximum="8.0" Value="{Binding BorderThickness}"
                                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                            ToolTip="{loc:Loc Filtering_ControlsHighlightBorderWidthCustom}">
                                                        <Slider.Style>
                                                            <Style TargetType="Slider" BasedOn="{StaticResource SettingsSlider}">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UseCustomBorderThickness}" Value="False">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.68"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Slider.Style>
                                                    </Slider>
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Filtering_KeywordMutingHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Filtering_NotificationsContainingTheseKeywordsWill}"/>
                        </Border>

                        <TextBlock Text="{loc:Loc Filtering_NewMuteRule}" Style="{StaticResource RuleFieldLabel}"
                                   ToolTip="{loc:Loc Filtering_TypeKeywordPatternThenAdd}"/>
                        <TextBox Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding NewMuteKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Filtering_TypeKeywordPatternPressAdd}"
                                 Margin="0,0,0,10"/>
                        <Button Content="{loc:Loc Filtering_AddMuteRule}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Command="{Binding AddMuteKeywordCommand}"
                                ToolTip="{loc:Loc Filtering_AddEnteredMuteRule}"/>

                        <ItemsControl ItemsSource="{Binding MuteKeywordEntries}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RuleCard}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Filtering_MatchText}" Style="{StaticResource RuleFieldLabel}"
                                                       ToolTip="{loc:Loc Filtering_EditTextPatternUsedMute}"/>
                                            <TextBox Style="{StaticResource SettingsTextBox}"
                                                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{loc:Loc Filtering_EditTextPatternUsedMute}"
                                                     Margin="0,0,0,10"/>

                                            <WrapPanel Margin="0,0,0,6">
                                                <ToggleButton Content="{loc:Loc Filtering_Regex}"
                                                              Style="{StaticResource RuleRegexToggle}"
                                                              IsChecked="{Binding IsRegex}"
                                                              ToolTip="{loc:Loc Filtering_EnabledKeywordTreatedRegularExpression}"/>
                                                <Button Content="{loc:Loc Common_Remove}"
                                                        Style="{StaticResource RuleActionButton}"
                                                        Command="{Binding DataContext.RemoveMuteKeywordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{loc:Loc Filtering_RemoveThisMuteRule}"/>
                                            </WrapPanel>

                                            <StackPanel Style="{StaticResource RuleFieldStack}">
                                                <TextBlock Text="{loc:Loc Filtering_MatchScope}" Style="{StaticResource RuleFieldLabel}"
                                                           ToolTip="{loc:Loc Filtering_ChooseWhetherMuteRuleSearches}"/>
                                                <ComboBox Style="{StaticResource SettingsComboBox}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                                          ItemsSource="{Binding DataContext.AvailableNotificationMatchScopes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          ItemTemplate="{StaticResource LocOptionItemTemplate}"
                                                          SelectedItem="{Binding Scope}"/>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Filtering_AppFilterOptional}" Style="{StaticResource RuleFieldLabel}"
                                                           ToolTip="{loc:Loc Filtering_LimitMuteRuleSpecificApp}"/>
                                                <TextBox Style="{StaticResource SettingsTextBox}"
                                                         Text="{Binding AppFilter, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{loc:Loc Filtering_LimitMuteRuleSpecificApp}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Filtering_NarrationRulesHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Filtering_OverrideNormalReadAloudBehavior}"/>
                        </Border>

                        <Border Style="{StaticResource RuleCard}">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding NarrationRulesOnlyEnabled}"
                                              ToolTip="{loc:Loc Filtering_EnabledBuiltNarrationStaysSilent}"/>
                                <TextBlock Text="{loc:Loc Filtering_OnlySpeakMatchingRules}" Style="{StaticResource SettingLabel}" Margin="0"
                                           ToolTip="{loc:Loc Filtering_EnabledBuiltNarrationStaysSilent}"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{loc:Loc Filtering_NewNarrationRule}" Style="{StaticResource RuleFieldLabel}"
                                   ToolTip="{loc:Loc Filtering_TypeKeywordHandleThenAdd}"/>
                        <TextBox Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding NewNarrationKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Filtering_TypeKeywordHandlePressAdd}"
                                 Margin="0,0,0,10"/>
                        <Button Content="{loc:Loc Filtering_AddNarrationRule}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Command="{Binding AddNarrationRuleCommand}"
                                ToolTip="{loc:Loc Filtering_AddNarrationRuleCanForce}"/>

                        <ItemsControl ItemsSource="{Binding NarrationRuleEntries}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RuleCard}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Filtering_MatchText}" Style="{StaticResource RuleFieldLabel}"
                                                       ToolTip="{loc:Loc Filtering_EditTextPatternUsedNarration}"/>
                                            <TextBox Style="{StaticResource SettingsTextBox}"
                                                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{loc:Loc Filtering_EditTextPatternUsedNarration}"
                                                     Margin="0,0,0,10"/>

                                            <WrapPanel Margin="0,0,0,6">
                                                <ToggleButton Content="{loc:Loc Filtering_Regex}"
                                                              Style="{StaticResource RuleRegexToggle}"
                                                              IsChecked="{Binding IsRegex}"
                                                              ToolTip="{loc:Loc Filtering_EnabledKeywordTreatedRegularExpression}"/>
                                                <Button Content="{loc:Loc Common_Remove}"
                                                        Style="{StaticResource RuleActionButton}"
                                                        Command="{Binding DataContext.RemoveNarrationRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{loc:Loc Filtering_RemoveThisNarrationRule}"/>
                                            </WrapPanel>

                                            <StackPanel Style="{StaticResource RuleFieldStack}">
                                                <TextBlock Text="{loc:Loc Filtering_MatchScope}" Style="{StaticResource RuleFieldLabel}"
                                                           ToolTip="{loc:Loc Filtering_ChooseWhetherNarrationRuleSearches}"/>
                                                <ComboBox Style="{StaticResource SettingsComboBox}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                                          ItemsSource="{Binding DataContext.AvailableNotificationMatchScopes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          ItemTemplate="{StaticResource LocOptionItemTemplate}"
                                                          SelectedItem="{Binding Scope}"/>
                                            </StackPanel>

                                            <StackPanel Style="{StaticResource RuleFieldStack}">
                                                <TextBlock Text="{loc:Loc Filtering_AppFilterOptional}" Style="{StaticResource RuleFieldLabel}"
                                                           ToolTip="{loc:Loc Filtering_LimitNarrationRuleAppsWhose}"/>
                                                <TextBox Style="{StaticResource SettingsTextBox}"
                                                         Text="{Binding AppFilter, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{loc:Loc Filtering_LimitNarrationRuleAppsWhose}"/>
                                            </StackPanel>

                                            <StackPanel Style="{StaticResource RuleFieldStack}">
                                                <TextBlock Text="{loc:Loc Filtering_Action}" Style="{StaticResource RuleFieldLabel}"
                                                           ToolTip="{loc:Loc Filtering_ChooseWhetherRuleForcesRead}"/>
                                                <ComboBox Style="{StaticResource SettingsComboBox}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                                          ItemsSource="{Binding DataContext.AvailableNarrationRuleActions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          ItemTemplate="{StaticResource LocOptionItemTemplate}"
                                                          SelectedItem="{Binding Action}"/>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Filtering_ReadMode}" Style="{StaticResource RuleFieldLabel}"
                                                           ToolTip="{loc:Loc Filtering_ChooseSpokenContentModeRule}"/>
                                                <ComboBox Style="{StaticResource SettingsComboBox}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                                          ItemsSource="{Binding DataContext.AvailableNarrationRuleReadModes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          ItemTemplate="{StaticResource LocOptionItemTemplate}"
                                                          SelectedItem="{Binding ReadMode}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ APPS TAB ═══ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Tag="Apps" AutomationProperties.Name="{loc:Loc Apps_AppsSettingsTab}"
                     IsSelected="{Binding IsAppsTabSelected, Mode=OneWayToSource}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <Path Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                              Data="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm-7 8a7 7 0 0 1 14 0"/>
                        <TextBlock Text="{loc:Loc Common_Apps}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Apps_PerAppOverridesHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Apps_AssignAppSpecificSoundIcon}"/>
                        </Border>

                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource SettingsTextBox}"
                                     Text="{Binding AppOverridesFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Loc Apps_FilterAppOverridesAppName}"/>

                            <CheckBox Grid.Column="1"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding ShowOnlyModifiedAppOverrides}"
                                      Content="{loc:Loc Apps_OnlyModified}"
                                      FontFamily="{StaticResource UIFont}"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="{loc:Loc Apps_HideAppsStillUseAll}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PerAppConfigEntriesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,12" Margin="0,0,0,10"
                                            CornerRadius="6" Background="{DynamicResource SurfaceLightBrush}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <Button DockPanel.Dock="Right"
                                                        Content="{loc:Loc Apps_ClearOverrides}"
                                                        Style="{StaticResource InlineSecondaryButton}"
                                                        Margin="12,0,0,0"
                                                        Command="{Binding ElementName=SettingsRoot, Path=DataContext.ClearPerAppOverridesCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{loc:Loc Apps_ReturnAppGlobalSoundIcon}"/>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding AppName}" Style="{StaticResource SettingLabel}"
                                                               FontWeight="SemiBold" Margin="0"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{loc:Loc Apps_ReadAloud}"
                                                           Style="{StaticResource SettingLabel}"
                                                           Margin="0,0,12,8"
                                                           ToolTip="{loc:Loc Apps_AppSpecificNarrationOverrideOnly}"/>
                                                <ToggleButton Grid.Row="0" Grid.Column="1"
                                                              Style="{StaticResource ToggleSwitch}"
                                                              HorizontalAlignment="Right"
                                                              Margin="0,0,0,8"
                                                              IsChecked="{Binding IsReadAloudEnabled}"
                                                              ToolTip="{loc:Loc Apps_EnabledBuiltSpokenNotificationsCan}"/>

                                                <!-- KR-Mnyang fork (P2-B): the app sound rule replaces the legacy sound drop-down
                                                     ("Default" / "None" / file). "None" used to inherit the default by mistake;
                                                     "Silent for this app" is now a real ExplicitSilence rule. -->
                                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                        DataContext="{Binding SoundRule}"
                                                        Margin="0,0,0,12" Padding="10,8" CornerRadius="6"
                                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc Apps_Sound}" Style="{StaticResource SettingLabel}" Margin="0,0,0,4"/>
                                                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                                                  ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                                                  ItemsSource="{x:Static vm:AppSoundRuleViewModel.ChoiceOptions}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Choice}"
                                                                  AutomationProperties.Name="{loc:LocFormat Apps_SoundForApp, Path=AppName}"
                                                                  ToolTip="{loc:Loc Apps_UseDefaultSoundMakeApp}"/>
                                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SettingDesc}" Margin="0,6,0,4"/>

                                                        <StackPanel Visibility="{Binding HasMultipleAppIds, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{loc:Loc Apps_SeveralAppIDsWereSeen}"
                                                                       Style="{StaticResource SettingDesc}" Margin="0,4,0,4"/>
                                                            <ComboBox Style="{StaticResource SettingsComboBox}"
                                                                      ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                                                      ItemsSource="{Binding RuleKeyOptions}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding SelectedRuleKey}"
                                                                      AutomationProperties.Name="{loc:Loc Apps_RuleAppliesTo}"/>
                                                        </StackPanel>

                                                        <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                                            <ContentControl Content="{Binding Editor}"
                                                                            ContentTemplate="{StaticResource SoundRuleEditorCoreTemplate}"
                                                                            Focusable="False"/>
                                                            <TextBlock Text="{loc:Loc Apps_AddFilesSoundLibrary}" Style="{StaticResource SettingLabel}"/>
                                                            <ItemsControl ItemsSource="{Binding Editor.Choices}" AutomationProperties.Name="{loc:Loc Apps_SoundLibraryFilesApp}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Style="{StaticResource SoundCheckBox}" Margin="0,2,0,2"
                                                                                  IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanToggle}">
                                                                            <TextBlock TextWrapping="Wrap">
                                                                                <Run Text="{Binding DisplayName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            </TextBlock>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{loc:Loc Apps_SoundLibraryEmptyImportFiles}"
                                                                       Style="{StaticResource SettingDesc}"
                                                                       Visibility="{Binding Editor.Choices.Count, Converter={StaticResource ZeroToVisible}}"/>
                                                        </StackPanel>

                                                        <TextBlock Style="{StaticResource SettingDesc}" Margin="0,8,0,0">
                                                            <Run Text="{loc:Loc Apps_ReceivedVia}"/><Run Text="{Binding ReceivePathText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <!-- KR-Mnyang fork (P4): original sound handling. Manual mute guidance by app type and
                                                             the user's own confirmation; the app never reads or changes the Windows/app setting. -->
                                                        <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="4"
                                                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap"
                                                                           AutomationProperties.AutomationId="OriginalSoundStatusText"
                                                                           AutomationProperties.Name="{loc:LocFormat ManualMute_StatusLine, Path=OriginalSoundStatusText}"
                                                                           ToolTip="{loc:Loc Apps_WhetherAppSOwnWindows}">
                                                                    <Run Text="{loc:Loc Apps_OriginalSoundHandling}"/><Run Text="{Binding OriginalSoundStatusText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ManualMuteGuidanceText}" Style="{StaticResource SettingDesc}"
                                                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                                                           AutomationProperties.AutomationId="ManualMuteGuidanceText"/>
                                                                <TextBlock Text="{loc:Loc ManualMute_NotVerifiedNote}" Style="{StaticResource SettingDesc}"
                                                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <WrapPanel Margin="0,6,0,0">
                                                                    <Button Content="{loc:Loc ManualMute_OpenWindowsSettings}" Style="{StaticResource SecondaryButton}"
                                                                            Margin="0,0,8,4"
                                                                            Command="{Binding OpenWindowsNotificationSettingsCommand}"
                                                                            Visibility="{Binding ShowWindowsNotificationSettingsButton, Converter={StaticResource BoolToVis}}"
                                                                            AutomationProperties.AutomationId="ManualMuteOpenSettingsButton"
                                                                            ToolTip="{loc:Loc ManualMute_OpenWindowsSettingsTip}"/>
                                                                    <Button Content="{loc:Loc ManualMute_MarkConfirmed}" Style="{StaticResource SecondaryButton}"
                                                                            Margin="0,0,8,4"
                                                                            Command="{Binding ConfirmManualMuteCommand}"
                                                                            Visibility="{Binding CanConfirmManualMute, Converter={StaticResource BoolToVis}}"
                                                                            AutomationProperties.AutomationId="ManualMuteConfirmButton"
                                                                            AutomationProperties.Name="{loc:LocFormat ManualMute_MarkConfirmedForApp, Path=AppName}"
                                                                            ToolTip="{loc:Loc ManualMute_MarkConfirmedTip}"/>
                                                                    <Button Content="{loc:Loc ManualMute_MarkRecheck}" Style="{StaticResource SecondaryButton}"
                                                                            Margin="0,0,8,4"
                                                                            Command="{Binding RequireManualMuteRecheckCommand}"
                                                                            Visibility="{Binding CanRequireManualMuteRecheck, Converter={StaticResource BoolToVis}}"
                                                                            AutomationProperties.AutomationId="ManualMuteRecheckButton"
                                                                            AutomationProperties.Name="{loc:LocFormat ManualMute_MarkRecheckForApp, Path=AppName}"/>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding LegacyInfoText}" Style="{StaticResource SettingDesc}" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasLegacyInfo, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Grid.Row="2" Grid.Column="0"
                                                           Text="{loc:Loc Apps_Icon}"
                                                           Style="{StaticResource SettingLabel}"
                                                           Margin="0,0,12,8"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1"
                                                          Style="{StaticResource SettingsComboBox}"
                                                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                                          Margin="0,0,0,12"
                                                          ItemsSource="{Binding ElementName=SettingsRoot, Path=DataContext.PerAppIconOptions}"
                                                          ItemTemplate="{StaticResource LocOptionItemTemplate}"
                                                          SelectedItem="{Binding Icon}"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0"
                                                           Text="{loc:Loc Apps_CardBackground}"
                                                           Style="{StaticResource SettingLabel}"
                                                           Margin="0,0,12,0"
                                                           VerticalAlignment="Top"
                                                           ToolTip="{loc:Loc Apps_OptionalAppSpecificCardBackground}"/>
                                                <StackPanel Grid.Row="3" Grid.Column="1">
                                                    <TextBox Style="{StaticResource SettingsTextBox}"
                                                             Text="{Binding BackgroundImageDisplay, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             VerticalContentAlignment="Center"
                                                             ToolTip="{Binding BackgroundImageToolTip}"/>
                                                    <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                                                        <Button Content="{loc:Loc Common_Browse}" Style="{StaticResource InlineSecondaryButton}"
                                                                Margin="0,0,8,0"
                                                                Command="{Binding ElementName=SettingsRoot, Path=DataContext.BrowsePerAppBackgroundImageCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{loc:Loc Apps_ChooseLocalImageUseOnly}"/>
                                                        <Button Content="{loc:Loc Common_Clear}" Style="{StaticResource InlineSecondaryButton}"
                                                                Command="{Binding ElementName=SettingsRoot, Path=DataContext.ClearPerAppBackgroundImageCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{loc:Loc Apps_RemoveAppSpecificBackgroundImage}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Loc Common_NoAppsSeenYetNotifications}"
                                   Style="{StaticResource SettingDesc}" Margin="0,4,0,0"
                                   Visibility="{Binding PerAppConfigEntries.Count, Converter={StaticResource ZeroToVisible}}"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ LAYOUT TAB ═══ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Tag="Layout" AutomationProperties.Name="{loc:Loc Layout_LayoutSettingsTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <!-- layout-template -->
                        <Path Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent" 
                              Data="M4 3a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H4zm-1 11a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6zm13-1a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-3z" />
                        <TextBlock Text="{loc:Loc Common_Layout}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Layout_MonitorHeader}" Style="{StaticResource SectionHeader}"/>
                        </Border>

                        <TextBlock Text="{loc:Loc Layout_TargetMonitor}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc Layout_ChooseMonitorThenClickMove}"/>
                        <ComboBox Style="{StaticResource SettingsComboBox}" Margin="0,4,0,6"
                                  ItemsSource="{Binding MonitorItems}"
                                  SelectedIndex="{Binding SelectedMonitorIndex}"
                                  ToolTip="{loc:Loc Layout_SelectWhichMonitorOverlayShould}"/>
                        <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,4">
                            <Button Content="{loc:Loc Layout_RefreshMonitors}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshMonitorsCommand}" Margin="0,0,8,8"
                                    ToolTip="{loc:Loc Layout_ReDetectConnectedMonitors}"/>
                            <Button Content="{loc:Loc Layout_MoveOverlay}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding MoveToMonitorCommand}" Margin="0,0,0,8"
                                    ToolTip="{loc:Loc Layout_MoveOverlaySelectedMonitor}"/>
                        </WrapPanel>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Layout_QuickPositionHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Layout_MoveOverlayCommonPositionsSelected}"/>
                        </Border>
                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <Button Content="{loc:Loc Layout_TopLeft}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="top-left"/>
                            <Button Content="{loc:Loc Layout_TopCenter}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="top-center"/>
                            <Button Content="{loc:Loc Layout_TopRight}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="top-right"/>
                            <Button Content="{loc:Loc Layout_MiddleLeft}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="middle-left"/>
                            <Button Content="{loc:Loc Layout_MiddleCenter}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="middle-center"/>
                            <Button Content="{loc:Loc Layout_MiddleRight}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="middle-right"/>
                            <Button Content="{loc:Loc Layout_BottomLeft}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="bottom-left"/>
                            <Button Content="{loc:Loc Layout_BottomCenter}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="bottom-center"/>
                            <Button Content="{loc:Loc Layout_BottomRight}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                                    Command="{Binding MoveOverlayPresetCommand}" CommandParameter="bottom-right"/>
                        </UniformGrid>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Layout_OverlaySizeHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Layout_ConfigureOverlayWidthHeightLimits}"/>
                        </Border>

                        <TextBlock Text="{loc:Loc Layout_OverlayWidth}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc Layout_WiderOverlaysShowMoreText}"/>
                        <DockPanel Margin="0,4,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox Style="{StaticResource SettingsTextBox}" Width="90"
                                         Margin="8,0,0,0" VerticalAlignment="Center"
                                         Text="{Binding OverlayWidth, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:0}'}"
                                         ToolTip="{loc:Loc Layout_TypeExactWidthPixels220}"/>
                                <TextBlock Style="{StaticResource SliderValue}" VerticalAlignment="Center"
                                           Margin="4,0,0,0" Text="px"/>
                            </StackPanel>
