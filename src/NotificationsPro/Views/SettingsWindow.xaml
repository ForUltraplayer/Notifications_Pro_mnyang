                        <DockPanel Margin="0,4,0,16">
                            <TextBlock DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                                       Text="{Binding SettingsElementOpacity, StringFormat={}{0:P0}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Slider Minimum="0.05" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SettingsElementOpacity}"
                                    Style="{StaticResource SettingsSlider}"
                                    ToolTip="{loc:Loc SettingsWindow_DragAdjustOpacityInteractiveUI}"/>
                        </DockPanel>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc SettingsWindow_CustomColorsHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc SettingsWindow_FineTuneSettingsWindowColors}"/>
                        </Border>

                        <TextBlock Text="{loc:Loc SettingsWindow_Background}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_MainBackgroundColorSettingsWindow}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowBg, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowBg" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowBg, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_Surface}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_ColorPanelsCardsElevatedSurfaces}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowSurface, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowSurface" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowSurface, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_SurfaceLight}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_LighterSurfaceVariantUsedInput}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowSurfaceLight, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowSurfaceLight" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowSurfaceLight, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_SurfaceHover}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_ColorShownHoveringOverInteractive}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowSurfaceHover, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowSurfaceHover" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowSurfaceHover, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_Text}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_PrimaryTextColorLabelsHeadings}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowText, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowText" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowText, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_TextSecondary}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_SecondaryTextColorDescriptionsHelp}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowTextSecondary, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowTextSecondary" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowTextSecondary, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_TextMuted}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_MutedTextColorPlaceholdersDisabled}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowTextMuted, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowTextMuted" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowTextMuted, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_Accent}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_AccentColorActiveTogglesSelected}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowAccent, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowAccent" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowAccent, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc SettingsWindow_Border}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc SettingsWindow_BorderColorSeparatorsInputOutlines}"/>
                        <DockPanel Margin="0,4,0,4">
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6"
                                    Background="{Binding SettingsWindowBorder, Converter={StaticResource ColorToBrush}}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Pick}" Style="{StaticResource ColorPickButton}"
                                    Margin="8,0,0,0"
                                    Tag="SettingsWindowBorder" Click="OnPickColorClick"/>
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding SettingsWindowBorder, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ SYSTEM TAB ═══ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Tag="System" AutomationProperties.Name="{loc:Loc System_SystemSettingsTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <!-- cpu / system -->
                        <Path Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent" 
                              Data="M4 4h16v16H4zm0 4h16M4 12h16M4 16h16M8 4v16M12 4v16M16 4v16" />
                        <TextBlock Text="{loc:Loc Common_System}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>

                        <!-- KR-Mnyang fork (P3): UI language (this PC only; not in profiles/exports/undo) -->
                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc System_LanguageHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc System_LanguageHeaderTip}"/>
                        </Border>

                        <TextBlock Text="{loc:Loc System_Language}" Style="{StaticResource SettingLabel}"
                                   ToolTip="{loc:Loc System_LanguageTip}"/>
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                  ItemsSource="{x:Static vm:SettingsViewModel.UiLanguageOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedUiLanguage}"
                                  AutomationProperties.AutomationId="UiLanguageComboBox"
                                  AutomationProperties.Name="{loc:Loc System_Language}"
                                  Margin="0,4,0,0"
                                  ToolTip="{loc:Loc System_LanguageTip}"/>
                        <TextBlock Text="{loc:Loc System_LanguageRestartNote}" Style="{StaticResource SettingDesc}"/>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc System_NotificationAccessHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc System_OpenWindowsNotificationAccessPage}"/>
                        </Border>

                        <TextBlock Text="{Binding NotificationAccessStatusSummary}" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="{Binding NotificationAccessStatusDetail}"
                                   Margin="0,6,0,8"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SettingDesc}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{loc:Loc System_OpenWindowsNotificationAccess}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8"
                                    Command="{Binding OpenNotificationAccessSettingsCommand}"
                                    ToolTip="{loc:Loc System_OpenWindowsSettingsPrivacyNotifications}"/>
                            <Button Content="{loc:Loc System_RetryAccessCheck}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8"
                                    Command="{Binding RetryNotificationAccessCommand}"
                                    ToolTip="{loc:Loc System_RetryDirectWinRTAccessCheck}"/>
                            <Button Content="{loc:Loc System_RunCaptureDiagnostic}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8"
                                    Command="{Binding RunCaptureDiagnosticCommand}"
                                    ToolTip="{loc:Loc System_CopyConciseLiveCaptureSnapshot}"/>
                        </WrapPanel>

                        <TextBlock Text="{loc:Loc System_CaptureMode}" Style="{StaticResource SettingLabel}"
                                   ToolTip="{loc:Loc System_AutoTriesWinRTFirstFalls}"/>
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                                  ItemsSource="{Binding AvailableNotificationCaptureModes}"
                                  ItemTemplate="{StaticResource LocOptionItemTemplate}"
                                  SelectedItem="{Binding NotificationCaptureMode}"
                                  Margin="0,4,0,0"
                                  ToolTip="{loc:Loc System_UseForceAccessibilityLiveNotifications}"/>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc System_SystemNotificationsHeader}" Style="{StaticResource SectionHeader}"/>
                        </Border>

                        <DockPanel Margin="0,0,0,8">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding SuppressToastPopups}"
                                       ToolTip="{loc:Loc System_SuppressionOnlyActiveWhileNotifications}"/>
                            <TextBlock Text="{loc:Loc System_SuppressToastPopups}" Style="{StaticResource SettingLabel}"
                                       ToolTip="{loc:Loc System_RemovesWindowsToastPopupsAfter}"/>
                        </DockPanel>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc System_SessionArchiveHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc System_KeepTemporaryRecordNotificationsReceived}"/>
                        </Border>

                        <DockPanel Margin="0,0,0,8">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding SessionArchiveEnabled}"
                                          ToolTip="{loc:Loc System_EnabledNotificationsKeptMemoryDuration}"/>
                            <TextBlock Text="{loc:Loc System_EnableSessionArchive}" Style="{StaticResource SettingLabel}"
                                       ToolTip="{loc:Loc System_TemporarilyStoresNotificationTextRAM}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc System_MaxArchiveItems}" Style="{StaticResource SettingLabel}"
                                   ToolTip="{loc:Loc System_MaximumNumberNotificationsKeepSession}"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SliderValue}">
                                <Run Text="{Binding SessionArchiveMaxItems, StringFormat='{}{0:0}'}"/>
                            </TextBlock>
                            <Slider Minimum="10" Maximum="1000" TickFrequency="10"
                                    Value="{Binding SessionArchiveMaxItems}"
                                    Style="{StaticResource SettingsSlider}"/>
                        </DockPanel>

                        <Button Content="{loc:Loc System_ViewArchiveCopyClipboard}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ViewSessionArchiveCommand}"
                                Margin="0,8,0,0" HorizontalAlignment="Left"
                                ToolTip="{loc:Loc System_CopiesAllArchivedNotificationsWindows}"/>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc System_StartupHeader}" Style="{StaticResource SectionHeader}"/>
                        </Border>

                        <!-- Packaged (MSIX) runs keep the original StartupTask toggle. -->
                        <DockPanel Margin="0,0,0,8"
                                   Visibility="{Binding UsesPackagedStartupTask, Converter={StaticResource BoolToVis}}">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding StartWithWindows}"
                                          ToolTip="{loc:Loc System_AutomaticallyStartNotificationsProSign}"/>
                            <TextBlock Text="{loc:Loc System_StartWithWindows}" Style="{StaticResource SettingLabel}" ToolTip="{loc:Loc System_AutomaticallyLaunchNotificationsProSign}"/>
                        </DockPanel>

                        <!-- KR-Mnyang fork (P4): unpackaged runs use a Task Scheduler logon task. Its OS state is
                             shown as is (registered / registered but disabled / not registered / blocked / check failed). -->
                        <StackPanel Visibility="{Binding UsesLogonTask, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,0,0,4">
                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding LogonTaskEnabled}"
                                              AutomationProperties.AutomationId="LogonTaskToggle"
                                              AutomationProperties.Name="{loc:Loc System_LogonTask}"
                                              ToolTip="{loc:Loc System_LogonTaskTip}"/>
                                <TextBlock Text="{loc:Loc System_LogonTask}" Style="{StaticResource SettingLabel}"
                                           ToolTip="{loc:Loc System_LogonTaskTip}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding LogonTaskStatusText}" Style="{StaticResource SettingDesc}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="LogonTaskStatusText"/>
                            <WrapPanel Margin="0,4,0,8">
                                <Button Content="{loc:Loc System_LogonTaskRefresh}" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,8"
                                        Command="{Binding RefreshLogonTaskStatusCommand}"
                                        AutomationProperties.AutomationId="LogonTaskRefreshButton"/>
                                <Button Content="{loc:Loc System_LogonTaskRemove}" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,8"
                                        Command="{Binding UnregisterLogonTaskCommand}"
                                        Visibility="{Binding CanUnregisterLogonTask, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.AutomationId="LogonTaskRemoveButton"
                                        ToolTip="{loc:Loc System_LogonTaskRemoveTip}"/>
                            </WrapPanel>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,4">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding StartMinimizedToTray}"
                                          AutomationProperties.AutomationId="StartMinimizedToTrayToggle"
                                          AutomationProperties.Name="{loc:Loc System_StartMinimizedToTray}"
                                          ToolTip="{loc:Loc System_StartMinimizedToTrayNote}"/>
                            <TextBlock Text="{loc:Loc System_StartMinimizedToTray}" Style="{StaticResource SettingLabel}"
                                       ToolTip="{loc:Loc System_StartMinimizedToTrayNote}"/>
                        </DockPanel>
                        <TextBlock Text="{loc:Loc System_StartMinimizedToTrayNote}" Style="{StaticResource SettingDesc}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- KR-Mnyang fork (P4): restart on failure is not offered in this version (P0: the Task
                             Scheduler RestartOnFailure did not restart the app). Shown disabled, stored value untouched. -->
                        <DockPanel Margin="0,0,0,4">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="False" IsEnabled="False"
                                          AutomationProperties.AutomationId="RestartOnCrashToggle"
                                          AutomationProperties.Name="{loc:Loc System_RestartOnCrash}"
                                          AutomationProperties.HelpText="{loc:Loc System_RestartOnCrashUnavailable}"/>
                            <TextBlock Text="{loc:Loc System_RestartOnCrash}" Style="{StaticResource SettingLabel}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </DockPanel>
                        <TextBlock Text="{loc:Loc System_RestartOnCrashUnavailable}" Style="{StaticResource SettingDesc}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   AutomationProperties.AutomationId="RestartOnCrashNote"/>

                        <!-- KR-Mnyang fork (P4, R08): previous run status from the run marker. The cause is never guessed. -->
                        <TextBlock Text="{loc:Loc System_PreviousRunLabel}" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="{Binding PreviousRunStatusText}" Style="{StaticResource SettingDesc}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"
                                   AutomationProperties.AutomationId="PreviousRunStatusText"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ PROFILES TAB ═══ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Tag="Profiles" AutomationProperties.Name="{loc:Loc Profiles_ProfilesSettingsTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <!-- users -->
                        <Path Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent" 
                              Data="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M16 3.128a4 4 0 0 1 0 7.744 M22 21v-2a4 4 0 0 0-3-3.87 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" />
                        <TextBlock Text="{loc:Loc Common_Profiles}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Profiles_SavedProfilesHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Profiles_SaveSwitchBetweenNamedConfiguration}"/>
                        </Border>

                        <DockPanel Margin="0,4,0,8">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Save}" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Command="{Binding SaveProfileCommand}"
                                    ToolTip="{loc:Loc Profiles_SaveCurrentSettingsNewProfile}"/>
                            <TextBox Style="{StaticResource SettingsTextBox}"
                                     Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Loc Profiles_EnterNameProfileWorkGaming}"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding SavedProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Delete}" Style="{StaticResource SecondaryButton}"
                                                Padding="8,4" Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Loc Profiles_DeleteThisProfile}"/>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Padding="10,6" HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Loc Profiles_LoadProfileReplacesAllCurrent}">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Profiles_ImportExportHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Profiles_SaveRestoreCompleteAppSettings}"/>
                        </Border>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{loc:Loc Profiles_ExportSettings}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Command="{Binding ExportSettingsCommand}"
                                    ToolTip="{loc:Loc Profiles_SaveAllCurrentSettingsJson}"/>
                            <Button Content="{loc:Loc Profiles_ImportSettings}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Command="{Binding ImportSettingsCommand}"
                                    ToolTip="{loc:Loc Profiles_LoadSettingsPreviouslyExportedJson}"/>
                            <Button Content="{loc:Loc Profiles_ImportFromOriginalApp}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Command="{Binding ImportLegacySettingsCommand}"
                                    AutomationProperties.Name="{loc:Loc Profiles_ImportSettingsOriginalNotificationsPro}"
                                    ToolTip="{loc:Loc Profiles_CopySettingsThemesProfilesAssets}"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ HELP TAB ═══ -->
            <!-- ═══ LABS TAB (KR-Mnyang fork): experimental, intentionally unfinished-looking ═══ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Tag="Labs" AutomationProperties.Name="{loc:Loc Labs_LabsSettingsTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <!-- flask -->
                        <Path Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                              Data="M9 3h6 M10 3v6.5L4.5 19a1.5 1.5 0 0 0 1.3 2.2h12.4a1.5 1.5 0 0 0 1.3-2.2L14 9.5V3 M7 15h10"/>
                        <TextBlock Text="{loc:Loc Common_Labs}"/>
                        <Border Margin="6,0,0,0" Padding="4,0" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource ErrorBrush}">
                            <TextBlock Text="{loc:Loc Labs_BetaBadge}" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryButtonForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
