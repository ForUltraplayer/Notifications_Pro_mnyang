<Window x:Class="NotificationsPro.Views.SettingsWindow"
        x:Name="SettingsRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NotificationsPro.Localization"
        xmlns:converters="clr-namespace:NotificationsPro.Converters"
        xmlns:vm="clr-namespace:NotificationsPro.ViewModels"
        Title="{loc:Loc Shell_NotificationsProSettings}"
        Icon="{Binding TrayIconImage}"
        Height="740" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        ResizeMode="CanResize"
        AutomationProperties.Name="{loc:Loc Shell_NotificationsProSettings2}">

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Width" Value="780"/>
            <Setter Property="MinWidth" Value="620"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompactSettingsWindow}" Value="True">
                    <Setter Property="Width" Value="620"/>
                    <Setter Property="MinWidth" Value="620"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:ColorToOpacityBrushConverter x:Key="ColorToOpacityBrush"/>
        <converters:NotificationBackgroundImageSourceConverter x:Key="NotificationBackgroundImageSource"/>
        <converters:BoolToMuteLabelConverter x:Key="BoolToMuteLabel"/>
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisible"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- KR-Mnyang fork (P3): show stored option values in the UI language; the stored value is unchanged. -->
        <DataTemplate x:Key="LocOptionItemTemplate">
            <TextBlock Text="{loc:LocOption}"/>
        </DataTemplate>
        <DataTemplate x:Key="LocThemeModeItemTemplate">
            <TextBlock Text="{loc:LocOption ThemeMode}"/>
        </DataTemplate>

        <!-- Section header panel — no border/padding, text stays perfectly aligned -->
        <Style x:Key="SectionHeaderPanel" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>

        <!-- Section header text — larger + accent color for clear distinction -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0"/>
            <!-- Tooltip set per-instance where needed -->
        </Style>

        <!-- Setting label -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <!-- Setting description -->
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <!-- Value display next to slider -->
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ColorPickButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="RuleFieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="RuleFieldStack" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="RuleColorSwatch" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RuleActionButton" TargetType="Button" BasedOn="{StaticResource InlineSecondaryButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="RulePreviewButton" TargetType="Button" BasedOn="{StaticResource InlinePrimaryButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="RuleRegexToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentMutedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusIndicatorBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ KR-Mnyang fork (P2-B): WAV rule editor pieces shared by the Sounds and Apps tabs ═══ -->
        <Style x:Key="SoundSmallButton" TargetType="Button" BasedOn="{StaticResource InlineSecondaryButton}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,4,0,0"/>
        </Style>

        <Style x:Key="SoundCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SoundProblemText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- One row of a rule's ordered file list (DataContext: SoundRuleFileItem; ItemsControl DataContext: SoundRuleEditorViewModel). -->
        <DataTemplate x:Key="SoundRuleFileRowTemplate">
            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="4" Background="{DynamicResource SurfaceHoverBrush}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Position, StringFormat='{}{0}.'}" MinWidth="24"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,6,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontFamily="{StaticResource UIFont}" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ProblemText}" Style="{StaticResource SoundProblemText}"
                                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="{loc:Loc SoundRule_Up}" Style="{StaticResource SoundSmallButton}"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{loc:Loc SoundRule_MoveUp}" ToolTip="{loc:Loc SoundRule_PlayThisFileEarlier}"/>
                        <Button Content="{loc:Loc SoundRule_Down}" Style="{StaticResource SoundSmallButton}"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{loc:Loc SoundRule_MoveDown}" ToolTip="{loc:Loc SoundRule_PlayThisFileLater}"/>
                        <Button Content="{loc:Loc Common_PreviewSound}" Style="{StaticResource SoundSmallButton}"
                                Command="{Binding DataContext.PreviewSoundCommand, ElementName=SettingsRoot}"
                                CommandParameter="{Binding}" ToolTip="{loc:Loc SoundRule_PlayFileOnceDoesNot}"/>
                        <Button Content="{loc:Loc Common_Remove}" Style="{StaticResource SoundSmallButton}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{loc:Loc SoundRule_RemoveFromThisList}"
                                ToolTip="{loc:Loc SoundRule_RemoveListOnlyFileNot}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Mode, repeat avoidance and ordered files of one rule (DataContext: SoundRuleEditorViewModel). -->
        <DataTemplate x:Key="SoundRuleEditorCoreTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc SoundRule_PlayMode}" Style="{StaticResource SettingLabel}"
                           ToolTip="{loc:Loc SoundRule_SinglePlaysFirstFileRandom}"/>
                <ComboBox Style="{StaticResource SettingsComboBox}"
                          ItemContainerStyle="{StaticResource SettingsComboBoxItem}"
                          ItemsSource="{x:Static vm:SoundRuleEditorViewModel.ModeOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Mode}"
                          AutomationProperties.Name="{loc:Loc SoundRule_PlayMode}"/>
                <CheckBox Content="{loc:Loc SoundRule_AvoidPlayingSameFileTwice}" Style="{StaticResource SoundCheckBox}"
                          Margin="0,8,0,0" IsChecked="{Binding AvoidRepeat}" IsEnabled="{Binding IsRandom}"
                          ToolTip="{loc:Loc SoundRule_RandomModeOnlyOneUsable}"/>
                <TextBlock Text="{loc:Loc SoundRule_SelectedFilesPlayOrder}" Style="{StaticResource SettingLabel}"
                           ToolTip="{loc:Loc SoundRule_OrderHerePlayOrderDoes}"/>
                <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource SoundRuleFileRowTemplate}"
                              AutomationProperties.Name="{loc:Loc SoundRule_SelectedFiles}"/>
                <TextBlock Text="{loc:Loc SoundRule_NoFilesSelectedListPlays}" Style="{StaticResource SettingDesc}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="{Binding SettingsWindowCornerRadius}"
            Background="{DynamicResource WindowBgBrush}"
            ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
            <DockPanel LastChildFill="True">
                <Image Source="{Binding TrayIconImage}" Width="28" Height="28"
                       Margin="0,0,12,0" VerticalAlignment="Top"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="&#xE10E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource SecondaryButton}" Padding="6,4" Margin="0,0,4,0"
                            Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip="{loc:Loc Shell_UndoLastChangeCtrlZ}"/>
                    <Button Content="&#xE10D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Style="{StaticResource SecondaryButton}" Padding="6,4" Margin="0,0,12,0"
                            Command="{Binding RedoCommand}"
                            IsEnabled="{Binding CanRedo}"
                            ToolTip="{loc:Loc Shell_RedoLastUndoneChangeCtrl}"/>
                    <TextBlock Text="{loc:Loc Common_Preview}" FontFamily="{StaticResource UIFont}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowPreviewCard}"
                                  Checked="OnPreviewExpanded" Unchecked="OnPreviewCollapsed"
                                  ToolTip="{loc:Loc Shell_ShowHideLivePreviewCard}" Margin="0,0,16,0"/>

                    <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <!-- Window Controls (needed when in Popup mode) -->
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,4,0"
                            Click="OnMinimizeClick" ToolTip="{loc:Loc Shell_MinimizeToTray}"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource SecondaryButton}" Padding="8,6"
                            Click="OnCloseClick" ToolTip="{loc:Loc Shell_Close}"/>
                </StackPanel>
                <TextBlock Text="Notifications Pro" FontFamily="{StaticResource UIFont}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- First-run tip bar -->
        <Border Grid.Row="1" Padding="16,10" Background="{DynamicResource SurfaceLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowFirstRunTip, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc Shell_GotIt}" Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DismissFirstRunTipCommand}"/>
                <TextBlock Text="{loc:Loc Shell_QuickTipsUseLeftSidebar}"
                           FontFamily="{StaticResource UIFont}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Live preview card -->
        <Border x:Name="PreviewContainer" Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowPreviewCard, Converter={StaticResource BoolToVis}}">
            <Border x:Name="PreviewCardOuter" CornerRadius="{Binding CornerRadius}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{Binding BorderColor, Converter={StaticResource ColorToBrush}}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBorder}" Value="True">
                                <Setter Property="BorderThickness" Value="{Binding BorderThickness}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border x:Name="PreviewCardAccent" CornerRadius="{Binding CornerRadius}" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{Binding AccentColor, Converter={StaticResource ColorToBrush}}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAccent}" Value="True">
                                    <Setter Property="BorderThickness">
                                        <Setter.Value>
                                            <Thickness Left="3" Top="0" Right="0" Bottom="0"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource ColorToOpacityBrush}">
                            <Binding Path="BackgroundColor"/>
                            <Binding Path="BackgroundOpacity"/>
                        </MultiBinding>
                    </Border.Background>
                    <Grid>
                        <Image Opacity="{Binding CardBackgroundImageOpacity}"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Stretch" Value="UniformToFill"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CardBackgroundMode}" Value="Image"/>
                                                <Condition Binding="{Binding CardBackgroundImagePlacement}" Value="Full Card"/>
                                                <Condition Binding="{Binding SingleLineMode}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding CardBackgroundImageFitMode}" Value="Fit Inside Card">
                                            <Setter Property="Stretch" Value="Uniform"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CardBackgroundImageFitMode}" Value="Original Size">
                                            <Setter Property="Stretch" Value="None"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CardBackgroundImageVerticalFocus}" Value="Top">
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CardBackgroundImageVerticalFocus}" Value="Bottom">
                                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource NotificationBackgroundImageSource}">
                                    <Binding Path="CardBackgroundImagePath"/>
                                    <Binding Path="CardBackgroundImageHueDegrees"/>
                                    <Binding Path="CardBackgroundImageBrightness"/>
                                    <Binding Path="CardBackgroundImageSaturation"/>
                                    <Binding Path="CardBackgroundImageContrast"/>
                                    <Binding Path="CardBackgroundImageBlackAndWhite"/>
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Grid Margin="{Binding Padding}" ClipToBounds="True">
                            <Image Opacity="{Binding CardBackgroundImageOpacity}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CardBackgroundMode}" Value="Image"/>
                                                    <Condition Binding="{Binding CardBackgroundImagePlacement}" Value="Inside Padding"/>
                                                    <Condition Binding="{Binding SingleLineMode}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding CardBackgroundImageFitMode}" Value="Fit Inside Card">
                                                <Setter Property="Stretch" Value="Uniform"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardBackgroundImageFitMode}" Value="Original Size">
                                                <Setter Property="Stretch" Value="None"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardBackgroundImageVerticalFocus}" Value="Top">
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardBackgroundImageVerticalFocus}" Value="Bottom">
                                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource NotificationBackgroundImageSource}">
                                        <Binding Path="CardBackgroundImagePath"/>
                                        <Binding Path="CardBackgroundImageHueDegrees"/>
                                        <Binding Path="CardBackgroundImageBrightness"/>
                                        <Binding Path="CardBackgroundImageSaturation"/>
                                        <Binding Path="CardBackgroundImageContrast"/>
                                        <Binding Path="CardBackgroundImageBlackAndWhite"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <StackPanel>
                            <TextBlock Text="Microsoft Teams"
                                       FontFamily="{Binding FontFamily}"
                                       FontSize="{Binding AppNameFontSize}"
                                       FontWeight="{Binding AppNameFontWeight}"
                                       Foreground="{Binding AppNameColor, Converter={StaticResource ColorToBrush}}"
                                       Visibility="{Binding ShowAppName, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="{Binding TextAlignment}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Shell_SarahSentAMessage}"
                                       FontFamily="{Binding FontFamily}"
                                       FontSize="{Binding TitleFontSize}"
                                       FontWeight="{Binding TitleFontWeight}"
                                       Foreground="{Binding TitleColor, Converter={StaticResource ColorToBrush}}"
                                       Visibility="{Binding ShowNotificationTitle, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="{Binding TextAlignment}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Shell_HeyAvailableQuickCallAbout}"
                                       FontFamily="{Binding FontFamily}"
                                       FontSize="{Binding FontSize}"
                                       FontWeight="{Binding FontWeight}"
                                       Foreground="{Binding TextColor, Converter={StaticResource ColorToBrush}}"
                                       Visibility="{Binding ShowNotificationBody, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="{Binding TextAlignment}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Loc Shell_2mAgo}"
                                       FontFamily="{Binding FontFamily}"
                                       FontSize="{Binding TimestampFontSize}"
                                       FontWeight="{Binding TimestampFontWeight}"
                                       Foreground="{Binding TimestampColor, Converter={StaticResource ColorToBrush}}"
                                       Visibility="{Binding ShowTimestamp, Converter={StaticResource BoolToVis}}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="{Binding TextAlignment}"
                                       Opacity="0.8"
                                       Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="MainTabControl" Grid.Row="3" Style="{StaticResource SettingsTabControl}" Margin="20,12,20,8"
                    AutomationProperties.Name="{loc:Loc Shell_SettingsCategories}"
                    KeyboardNavigation.TabNavigation="Cycle">

            <!-- ═══ PROFILES TAB ═══ -->
            <!-- ═══ APPEARANCE TAB ═══ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Tag="Appearance" AutomationProperties.Name="{loc:Loc Appearance_AppearanceSettingsTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <!-- palette -->
                        <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse Canvas.Left="13" Canvas.Top="6" Width="2" Height="2" Fill="{DynamicResource TextPrimaryBrush}"/>
                                <Ellipse Canvas.Left="17" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource TextPrimaryBrush}"/>
                                <Ellipse Canvas.Left="6" Canvas.Top="12" Width="2" Height="2" Fill="{DynamicResource TextPrimaryBrush}"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="7" Width="2" Height="2" Fill="{DynamicResource TextPrimaryBrush}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{loc:Loc Common_Appearance}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>

                        <!-- OVERLAY THEMES section -->
                        <Border Style="{StaticResource SectionHeaderPanel}">
                            <TextBlock Text="{loc:Loc Appearance_OverlayThemesHeader}" Style="{StaticResource SectionHeader}"
                                       ToolTip="{loc:Loc Appearance_QuicklyStyleNotificationCardsThese}"/>
                        </Border>

                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Appearance_Apply}" Style="{StaticResource PrimaryButton}"
